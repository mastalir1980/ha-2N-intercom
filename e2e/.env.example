# Copy to e2e/.env (gitignored, chmod 600) and fill in.
# HA_TOKEN / HA_E2E_PASSWORD are written by `make e2e-bootstrap`.

# --- Raspberry Pi -----------------------------------------------------------
PI_SSH=user@pi.local                     # anything `ssh` accepts, incl. a ~/.ssh/config alias
PI_STAGING_DIR=/home/user/ha-staging     # staging compose + config live here
HA_CONTAINER=ha-staging

# --- Staging Home Assistant --------------------------------------------------
HA_URL=http://pi.local:8124
HA_TOKEN=
HA_E2E_PASSWORD=

# --- 2N intercom -------------------------------------------------------------
INTERCOM_HOST=192.0.2.10
INTERCOM_USER=
INTERCOM_PASSWORD=
INTERCOM_PROTOCOL=https
INTERCOM_VERIFY_SSL=0

# --- Safety ------------------------------------------------------------------
# Relays the tests may PHYSICALLY switch, only when run with --relays (manual run).
# Nightly runs never switch relays, whatever is set here.
E2E_RELAY_NUMBERS=1
# Physical IO outputs to latch on/off, comma-separated, only with --relays.
# Empty skips these tests. Manually enable the listed HA switches first.
# Direct relay control bypasses logical switch timing and can leave a door unlocked.
E2E_IO_OUTPUTS=

# --- Agent -------------------------------------------------------------------
# Set to 0 to skip the Claude triage step (tests + report only).
E2E_AGENT=1

# Only for the manual relay test test_50 grant_access (opens a real door!).
# Directory user uuid sent to /api/accesspoint/grantaccess; test skips when empty.
E2E_GRANT_USER_UUID=
